# ── Data mode ─────────────────────────────────────────────────────────────
# true  → static demo mode: all data lives in this browser (IndexedDB), seeded with demo data.
# false → Supabase mode: needs the two Supabase values below and the SQL in supabase/ applied.
VITE_STATIC_DATA_MODE=true

# ── Supabase (only read when VITE_STATIC_DATA_MODE=false) ─────────────────
VITE_MELSTAR_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key — public by design; never put the secret/service key here.
VITE_MELSTAR_SUPABASE_KEY=YOUR-PUBLISHABLE-KEY
# Show the two demo-login buttons on the sign-in page in Supabase mode (off for production).
VITE_SHOW_DEMO_LOGINS=false
